# Copy to backend/.env for local (non-Docker) development.
# docker-compose works without any .env file (it has sensible defaults).

APP_ENV=local
DATABASE_URL=postgresql+psycopg://taskuser:taskpass@localhost:5432/tasks
JWT_SECRET_KEY=change-me-in-production-please-32b
ACCESS_TOKEN_EXPIRE_MINUTES=60
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=5/minute
# Empty = in-memory limiter storage; use Redis when running more than one API process.
RATE_LIMIT_STORAGE_URL=
CORS_ORIGINS=["http://localhost:5173"]

# Frontend (frontend/.env)
VITE_API_URL=http://localhost:8000/api/v1
